{
  "name": "@hibira-io/react-native",
  "version": "0.1.1",
  "description": "React Native and Expo hooks for Hibira and other Pusher-compatible servers: channels, events, presence, LLM streams, chunked payloads that fit 4 KB messages, and push notifications through Hibira Push",
  "keywords": [
    "react-native",
    "expo",
    "hooks",
    "pusher",
    "pusher-js",
    "websocket",
    "realtime",
    "presence",
    "push notifications",
    "expo-notifications",
    "beams",
    "hibira"
  ],
  "homepage": "https://hibira.io",
  "bugs": {
    "url": "https://github.com/hibira-io/react-native/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hibira-io/react-native.git"
  },
  "license": "MIT",
  "author": "Hibira (https://hibira.io)",
  "type": "module",
  "main": "index.js",
  "types": "index.d.ts",
  "react-native": "index.js",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./push": {
      "types": "./push.d.ts",
      "default": "./push.js"
    },
    "./expo": {
      "types": "./expo.d.ts",
      "default": "./expo.js"
    },
    "./server": {
      "types": "./server.d.ts",
      "default": "./server.js"
    },
    "./chunk": {
      "types": "./chunk.d.ts",
      "default": "./chunk.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "*.js",
    "*.d.ts",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --import ./test/stubs/register.mjs --test test/*.test.mjs",
    "test:e2e": "node --import ./test/stubs/register.mjs --test test/e2e/*.e2e.mjs",
    "typecheck": "tsc -p test/tsconfig.json"
  },
  "dependencies": {
    "@hibira-io/react": "^0.1.1"
  },
  "peerDependencies": {
    "@react-native-async-storage/async-storage": ">=1.17",
    "@react-native-community/netinfo": ">=9",
    "expo-notifications": ">=0.20",
    "pusher-js": ">=8",
    "react": ">=17",
    "react-native": ">=0.70"
  },
  "peerDependenciesMeta": {
    "@react-native-async-storage/async-storage": {
      "optional": true
    },
    "expo-notifications": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "pusher": "^5.3.4",
    "pusher-js": "^8.6.0",
    "react": "^19.2.0",
    "react-test-renderer": "^19.2.0",
    "typescript": "^5.9.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
